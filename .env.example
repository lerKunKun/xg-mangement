# Runtime
APP_ENV=development
HTTP_ADDRESS=:8080
AUTH_DEV_LOGIN_ENABLED=false
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
WEB_BASE_URL=http://localhost:3000

# Local infrastructure
DATABASE_URL=postgres://xg:xg@localhost:5432/xg?sslmode=disable
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://xg:xg@localhost:5672/
RABBITMQ_QUEUE=xg.jobs
RABBITMQ_RETRY_DELAY=30s

# Cloudflare R2 in production; MinIO defaults for local development
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=xg-assets
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_PATH_STYLE=true

# Shopify standalone app authorization
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:8080/api/v1/integrations/shopify/callback
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,write_products,read_orders
SHOPIFY_SYNC_POLL_INTERVAL=5s
SHOPIFY_SYNC_TIMEOUT=15m
SHOPIFY_SYNC_MAX_ATTEMPTS=5

# DingTalk organization application
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_REDIRECT_URI=http://localhost:8080/api/v1/integrations/dingtalk/callback

# Reserved for later adapters
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REDIRECT_URI=
GOOGLE_ADS_DEVELOPER_TOKEN=
